"use strict";
// write code here
var appendRow = document.querySelector(".append-row");
var removeRow = document.querySelector(".remove-row");
var appendColumn = document.querySelector(".append-column");
var removeColumn = document.querySelector(".remove-column");
var table = document.querySelector("tbody");
var rowsNumber = table.childElementCount;
var columnsNumber = table.firstChild.childElementCount;
var removeTable = function() {
    while(table.firstChild)table.firstChild.remove();
};
var drawColumns = function() {
    for(var i = 0; i < rowsNumber; i++){
        var tr = "<tr>";
        var cells = "";
        for(var j = 0; j < columnsNumber; j++)cells += "<td></td>";
        tr += cells + "</tr>";
        table.innerHTML += tr;
    }
};
appendRow.addEventListener("click", function(e) {
    if (rowsNumber < 10) {
        removeRow.disabled = false;
        rowsNumber++;
        removeTable();
        drawColumns();
    }
    if (rowsNumber === 10) e.target.disabled = true;
});
removeRow.addEventListener("click", function(e) {
    if (rowsNumber > 2) {
        appendRow.disabled = false;
        rowsNumber--;
        removeTable();
        drawColumns();
    }
    if (rowsNumber === 2) e.target.disabled = true;
});
appendColumn.addEventListener("click", function(e) {
    if (columnsNumber < 10) {
        removeColumn.disabled = false;
        columnsNumber++;
        removeTable();
        drawColumns();
    }
    if (columnsNumber === 10) e.target.disabled = true;
});
removeColumn.addEventListener("click", function(e) {
    if (columnsNumber > 2) {
        appendColumn.disabled = false;
        columnsNumber--;
        removeTable();
        drawColumns();
    }
    if (columnsNumber === 2) e.target.disabled = true;
});

